cd $WORKDIR
env SIM=sim
mkdir -p $SIM/lib $SIM/data
cp $REPODIR/dse/modelc/build/_out/examples/binary/lib/libbinary.so $SIM/lib/libbinary.so
cp $WORK/simulation.yaml $SIM/data/simulation.yaml


# TEST: stream tcp, 16 Models connect/register concurrently - stresses the
# SimBus accept/drain loop and its poll_fds/models vector bookkeeping.
exec sh -e $WORK/test.sh

stdout 'Server \(bus\) listening'
stdout 'Client \(model\) connected'
stdout 'Completed models: 16'
! stdout 'Failed to send'
! stdout 'FATAL'


-- test.sh --
SIMER="${SIMER:-ghcr.io/boschglobal/dse-simer:latest}"

docker run --name simbus -i --rm \
    -v $ENTRYWORKDIR/$SIM:/sim \
    --network=host \
    --entrypoint="" $SIMER \
    /usr/local/bin/simbus --name simbus --logger 3 \
        --transport stream --uri tcp://127.0.0.1:5015 \
        --timeout 30 \
        data/simulation.yaml \
    > simbus.log 2>&1 &

# All 16 Models start together, no stagger - genuine concurrent connect load.
for i in $(seq 1 16); do
    docker run --name model$i -i --rm \
        -v $ENTRYWORKDIR/$SIM:/sim \
        --network=host \
        --entrypoint="" $SIMER \
        /usr/local/bin/modelc --name inst$i --logger 3 \
            --transport stream --uri tcp://127.0.0.1:5015 \
            data/simulation.yaml \
        > model$i.log 2>&1 &
done

wait

cat simbus.log
for i in $(seq 1 16); do cat model$i.log; done

COMPLETED=$(grep -l "Controller exit" model*.log | wc -l)
echo "Completed models: $COMPLETED"


-- simulation.yaml --
---
kind: Stack
metadata:
  name: socket_manyclients_stack
spec:
  connection:
    transport:
      stream:
        uri: tcp://127.0.0.1:5015
        timeout: 30
  models:
    - name: simbus
      model:
        name: simbus
      channels:
        - name: scalar_channel
          expectedModelCount: 16
        - name: binary_channel
          expectedModelCount: 16
    - name: inst1
      uid: 41
      model:
        name: Binary
      channels:
        - name: scalar_channel
          alias: scalar
        - name: binary_channel
          alias: binary
