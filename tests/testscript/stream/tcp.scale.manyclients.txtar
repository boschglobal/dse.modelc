---
kind: Model
metadata:
  name: simbus
---
kind: Model
metadata:
  name: Binary
spec:
  runtime:
    dynlib:
      - os: linux
        arch: amd64
        path: lib/libbinary.so
      - os: linux
        arch: x86
        path: lib/libbinary.so
      - os: windows
        arch: x64
        path: lib/libbinary.dll
      - os: windows
        arch: x86
        path: lib/libbinary.dll
  channels:
    - alias: scalar
      selectors:
        channel: scalar_channel
    - alias: binary
      selectors:
        channel: binary_channel
---
kind: SignalGroup
metadata:
  name: scalar_channel
  labels:
    channel: scalar_channel
spec:
  signals:
    - signal: counter
---
kind: SignalGroup
metadata:
  name: binary_channel
  labels:
    channel: binary_channel
  annotations:
    vector_type: binary
spec:
  signals:
    - signal: message
      annotations:
        mime_type: 'application/octet-stream'
