env NAME=Observer
env SIM=dse/modelc/build/_out/examples/binary


# TEST: binary example model
exec sh -e $WORK/test.sh

stderr 'Using Valgrind'
stdout 'Load YAML File: data/simulation.yaml'
stdout '\[A\] Run the Simulation ...'
stdout '\[B\] Run the Simulation ...'
stdout '\[C\] Run the Simulation ...'
stdout '\[Observer\] Run the Simulation ...'
stdout '\[A\] Controller exit ...'
stdout '\[B\] Controller exit ...'
stdout '\[C\] Controller exit ...'
stdout '\[Observer\] Controller exit ...'
stdout '\[Observer@0\.002000\] Message: A count is 14 '
stdout '\[Observer@0\.002000\] Message: B count is 304 '
stdout '\[Observer@0\.002000\] Message: C count is 5004 '

-- test.sh --
SIMER="${SIMER:-ghcr.io/boschglobal/dse-simer:latest}"
docker run --name simer -i --rm -v $ENTRYHOSTDIR/$SIM:/sim \
    $SIMER -valgrind $NAME -env $NAME:SIMBUS_LOGLEVEL=2
