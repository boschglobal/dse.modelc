env NAME=input,linear,observer
env SIM=dse/modelc/build/_out/examples/runtime


# TEST: Runtime
exec sh -e $WORK/test.sh

stdout 'Importer: Runtime: lib/libruntime.so'
stdout 'Importer: Simulation Path: sim'
stdout 'Importer: Simulation YAML: data/simulation.yaml'
stdout 'Importer: Model: input,linear,observer'
stdout 'Runtime: Simulation YAML: sim/data/simulation.yaml'
stdout 'Runtime: Virtual Model: runtime'
stdout 'Load YAML File: sim/data/simulation.yaml'
stdout 'Load YAML File: sim/model/input/data/model.yaml'
stdout 'Load YAML File: sim/model/linear/data/model.yaml'
stdout 'Load YAML File: sim/model/observer/data/model.yaml'
stdout 'Importer: Runtime Model runtime @ 0.000500'
stdout '      - name : output'
stdout '        value: 5'
stdout 'Importer: PDU id=1001 ecu_id=2 swc_id=5 \[0.000500\]output=5.000000'
stdout 'Importer: PDU id=1002 ecu_id=2 swc_id=5 \[0.001000\]output=0.790000'
stdout 'Importer: Calling vtable.destroy\(\)'


-- test.sh --
SIMER="${SIMER:-ghcr.io/boschglobal/dse-simer:latest}"
docker run --name simer -i --rm \
    -v $ENTRYHOSTDIR/$SIM:/sim \
    --entrypoint="" $SIMER \
    valgrind  \
        --leak-check=yes \
        --gen-suppressions=yes \
        --error-exitcode=808 \
    bin/importer lib/libruntime.so sim data/simulation.yaml input,linear,observer
