env NAME=extended_inst
env SIM=dse/modelc/build/_out/examples/extended


# TEST: inspect
exec sh -e $WORK/test.sh
cmp stdout expect.inspect

-- test.sh --
INSPECT="${INSPECT:-ghcr.io/boschglobal/dse-inspect:latest}"
docker run --name inspect -i --rm -v $ENTRYHOSTDIR/$SIM:/sim $INSPECT

-- expect.inspect --
