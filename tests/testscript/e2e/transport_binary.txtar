env NAME=Observer
env SIM=dse/modelc/build/_out/examples/binary


# TEST: redispubsub
env SIMBUS_TRANSPORT=redispubsub
env SIMBUS_URI=redis://localhost:6379
exec sh -e $WORK/test.sh

stderr 'Using Valgrind'
stdout 'Transport: redispubsub'
stdout 'URI: redis://localhost:6379'
stdout '\[Observer@0\.002000\] Message: A count is 14 '
stdout '\[Observer@0\.002000\] Message: B count is 304 '
stdout '\[Observer@0\.002000\] Message: C count is 5004 '


# TEST: redis
env SIMBUS_TRANSPORT=redis
env SIMBUS_URI=redis://localhost:6379
exec sh -e $WORK/test.sh

stderr 'Using Valgrind'
stdout 'Transport: redis'
! stdout 'Transport: redispubsub'
stdout 'URI: redis://localhost:6379'
stdout '\[Observer@0\.002000\] Message: A count is 14 '
stdout '\[Observer@0\.002000\] Message: B count is 304 '
stdout '\[Observer@0\.002000\] Message: C count is 5004 '


# TEST: redisasync
env SIMBUS_TRANSPORT=redis
env SIMBUS_URI=redisasync://localhost:6379
exec sh -e $WORK/test.sh

stderr 'Using Valgrind'
stdout 'Transport: redis'
! stdout 'Transport: redispubsub'
stdout 'URI: redisasync://localhost:6379'
stdout '\[Observer@0\.002000\] Message: A count is 14 '
stdout '\[Observer@0\.002000\] Message: B count is 304 '
stdout '\[Observer@0\.002000\] Message: C count is 5004 '


# TEST: loopback
env SIMBUS_TRANSPORT=loopback
env SIMBUS_URI=loopback
exec sh -e $WORK/test-loopback.sh

stderr 'Using Valgrind'
stdout 'Transport: loopback'
stdout 'URI: loopback'
stdout '\[Observer@0\.002000\] Message: A count is 14 '
stdout '\[Observer@0\.002000\] Message: B count is 304 '
stdout '\[Observer@0\.002000\] Message: C count is 5004 '


# TEST: stream unix
env SIMBUS_TRANSPORT=stream
env SIMBUS_URI=unix:///tmp/simbus.sock
exec sh -e $WORK/test-stream.sh

stderr 'Using Valgrind'
stdout 'Transport: stream'
stdout 'URI: unix:///tmp/simbus.sock'
stdout '\[Observer@0\.002000\] Message: A count is 14 '
stdout '\[Observer@0\.002000\] Message: B count is 304 '
stdout '\[Observer@0\.002000\] Message: C count is 5004 '


# TEST: stream tcp
env SIMBUS_TRANSPORT=stream
env SIMBUS_URI=tcp://127.0.0.1
exec sh -e $WORK/test-stream.sh

stderr 'Using Valgrind'
stdout 'Transport: stream'
stdout 'URI: tcp://127.0.0.1'
stdout '\[Observer@0\.002000\] Message: A count is 14 '
stdout '\[Observer@0\.002000\] Message: B count is 304 '
stdout '\[Observer@0\.002000\] Message: C count is 5004 '


-- test.sh --
SIMER="${SIMER:-ghcr.io/boschglobal/dse-simer:latest}"
docker run --name simer -i --rm -v $ENTRYHOSTDIR/$SIM:/sim \
    $SIMER -valgrind $NAME \
        -env SIMBUS_TRANSPORT=$SIMBUS_TRANSPORT \
        -env SIMBUS_URI=$SIMBUS_URI \
        -env $NAME:SIMBUS_LOGLEVEL=2


-- test-loopback.sh --
SIMER="${SIMER:-ghcr.io/boschglobal/dse-simer:latest}"
docker run --name simer -i --rm -v $ENTRYHOSTDIR/$SIM:/sim \
    $SIMER --logger 1 -valgrind $NAME -simbus="" -redis="" \
        -env SIMBUS_TRANSPORT=$SIMBUS_TRANSPORT \
        -env SIMBUS_URI=$SIMBUS_URI \
        -env SIMBUS_LOGLEVEL=2

-- test-stream.sh --
SIMER="${SIMER:-ghcr.io/boschglobal/dse-simer:latest}"
docker run --name simer -i --rm -v $ENTRYHOSTDIR/$SIM:/sim \
    $SIMER -valgrind $NAME -redis="" \
        -env SIMBUS_TRANSPORT=$SIMBUS_TRANSPORT \
        -env SIMBUS_URI=$SIMBUS_URI \
        -env $NAME:SIMBUS_LOGLEVEL=2
